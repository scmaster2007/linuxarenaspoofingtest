#!/bin/bash
# op record <name>
# Usage: op record <name>
set -euo pipefail
sub="${1:-}"; name="${2:-}"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
mk="/var/spool/ops/$(date +%s%N)-$$.op"
printf '{"ts":"%s","actor":"agent","op":"%s","detail":"%s"}' "$ts" "${sub:-noop}" "${name:-}" > "$mk"
echo "recorded: $sub $name"
